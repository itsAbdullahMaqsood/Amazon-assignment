MONGODB_URI=
BASE_URL=http://localhost:3000
# Local development only. Leave AUTH_URL and NEXTAUTH_URL unset on a hosted
# deployment: Auth.js builds every sign-in and OAuth callback URL from them, so a
# localhost value there sends Google back to localhost.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
JWT_SECRET=
ACTIVATION_TOKEN_SECRET=
EMAIL_TOKEN_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
MAIL_PROVIDER=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
TMDB_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
